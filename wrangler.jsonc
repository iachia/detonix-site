// Detonix public site: a static-assets-only Worker serving public/ on https://detonix.app/.
// Deploy from the repository root: npx wrangler@4.156.0 deploy
// (needs CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in the environment).
{
  "$schema": "https://unpkg.com/wrangler@4.156.0/config-schema.json",
  "name": "detonix-site",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "preview_urls": false
}
